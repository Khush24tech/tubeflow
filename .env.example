# Gemini API Key (accessed server-side)
GEMINI_API_KEY=

# Firebase Configuration (client-side optional override)
VITE_FIREBASE_API_KEY=

# Firebase Admin Service Account Key (JSON string or base64 string for server-side auth)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternatively, path to service account key file (e.g. serviceAccountKey.json)
GOOGLE_APPLICATION_CREDENTIALS=
